# Copie este arquivo para .env (uso local) e configure as MESMAS variáveis em
# Vercel → Project → Settings → Environment Variables. O .env nunca vai para o git.

# ---------------------------------------------------------------- essenciais
# Na Vercel o ambiente é "production" automaticamente. Localmente: development (padrão).
MESA_ENV=development

# OBRIGATÓRIA em produção (assina cookies e tokens CSRF). Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Em desenvolvimento, se vazia, uma chave local é criada em instance/.secret_key.
SECRET_KEY=

# Postgres (Neon). Na Vercel, criar o banco pela aba Storage/Marketplace já preenche DATABASE_URL/POSTGRES_URL.
# Sem esta variável, o app usa SQLite em instance/mesa.sqlite3 (só para uso local).
# Para rodar `flask db upgrade` use a conexão DIRETA (sem pooler), ex.: POSTGRES_URL_NON_POOLING.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ---------------------------------------------------------------- cadastro (quem pode criar conta)
# Código de convite exigido no /cadastro. RECOMENDADO em produção: só quem recebe o código cria conta.
# Sem INVITE_CODE, o cadastro fica FECHADO em produção (a menos que ALLOW_OPEN_REGISTRATION=1).
INVITE_CODE=
# ALLOW_OPEN_REGISTRATION=1

# ---------------------------------------------------------------- imagens
# Vercel Blob (arquivos privados). Ao criar um Blob store na aba Storage do projeto, esta variável é preenchida
# sozinha. Sem ela (uso local), as imagens ficam no próprio banco.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Cota de imagens por conta, em MB. Atenção: o backup (.zip com as imagens) precisa caber em ~4 MB na Vercel.
USER_IMAGE_QUOTA_MB=3

# ---------------------------------------------------------------- mensagens (OPCIONAL)
# Os botões de WhatsApp/SMS por link funcionam SEM nada disto. As variáveis abaixo só habilitam o
# envio direto pelo servidor (Twilio), e só para contas liberadas com: flask grant-messaging email@exemplo.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+15551234567          # número Twilio para SMS
# TWILIO_WHATSAPP_FROM=+14155238886     # remetente WhatsApp (sandbox do Twilio ou número aprovado)
# MESSAGES_PER_DAY=30                   # limite diário por conta
# DEFAULT_COUNTRY_CODE=55               # usado quando o telefone é digitado sem o código do país

# ---------------------------------------------------------------- e-mail ao administrador (liberação de imagens)
# Resend (resend.com, plano gratuito). Sem domínio verificado, o Resend só envia para o e-mail da própria conta
# Resend: use esse mesmo e-mail em ADMIN_EMAIL (pode reaproveitar a chave do Professor Helper).
# RESEND_API_KEY=re_...
# ADMIN_EMAIL=mesmo-email-da-conta-resend@exemplo.com
# RESEND_FROM=Mesa do Mestre <onboarding@resend.dev>

# ---------------------------------------------------------------- servidor local
HOST=127.0.0.1
PORT=5000
