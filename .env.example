# Configuração OPCIONAL. Para uso normal NÃO é preciso criar o .env: o `local\iniciar.bat` já configura tudo.
# Use este arquivo só se for rodar com `python run.py` / `flask` diretamente (copie para .env). O .env nunca vai para o git.

# ---------------------------------------------------------------- essenciais
# development (padrão) ou production (exige SECRET_KEY e HTTPS para cookies Secure).
MESA_ENV=development

# Em desenvolvimento, se vazia, uma chave local é criada em instance/.secret_key.
# Em produção é OBRIGATÓRIA: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Sem esta variável o app usa SQLite em instance/mesa.sqlite3. Também aceita Postgres:
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ---------------------------------------------------------------- cadastro (quem pode criar conta)
# Código de convite exigido no /cadastro. Sem ele, o cadastro é livre em desenvolvimento e fechado em produção
# (a menos que ALLOW_OPEN_REGISTRATION=1).
INVITE_CODE=
# ALLOW_OPEN_REGISTRATION=1
# A primeira conta de um banco vazio vira administradora (padrão). Não há variável para isso: veja config.py.

# ---------------------------------------------------------------- imagens
# Cota de imagens por conta, em MB (as imagens ficam no banco e entram no backup).
USER_IMAGE_QUOTA_MB=3

# ---------------------------------------------------------------- mensagens (OPCIONAL)
# Os botões de WhatsApp/SMS por link funcionam SEM nada disto. As variáveis abaixo só habilitam o
# envio direto pelo servidor (Twilio), e só para contas liberadas com: flask grant-messaging email@exemplo.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+15551234567          # número Twilio para SMS
# TWILIO_WHATSAPP_FROM=+14155238886     # remetente WhatsApp (sandbox do Twilio ou número aprovado)
# MESSAGES_PER_DAY=30                   # limite diário por conta
# DEFAULT_COUNTRY_CODE=55               # usado quando o telefone é digitado sem o código do país

# ---------------------------------------------------------------- e-mail ao administrador (liberação de imagens)
# Resend (resend.com, plano gratuito). Sem domínio verificado, o Resend só envia para o e-mail da própria conta
# Resend: use esse mesmo e-mail em ADMIN_EMAIL (pode reaproveitar a chave do Professor Helper).
# RESEND_API_KEY=re_...
# ADMIN_EMAIL=mesmo-email-da-conta-resend@exemplo.com
# RESEND_FROM=Mesa do Mestre <onboarding@resend.dev>

# ---------------------------------------------------------------- servidor local
HOST=127.0.0.1
PORT=5000
